<?xml version="1.0" encoding="utf-8"?>
<!-- Switch-style square host tile. Ids are bound by PcGridAdapter. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/thor_tile_size"
    android:background="@drawable/pc_item_selector"
    android:padding="3dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/pc_grid_item_clip_bg"
        android:clipToOutline="true"
        android:outlineProvider="background">

        <!-- Legacy decoration slots, kept hidden for the adapter. -->
        <View
            android:id="@+id/pcIconGlow"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <View
            android:id="@+id/pcIconBg"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <!-- Box art fills the tile; the plain PC icon is padded by the adapter. -->
        <ImageView
            android:id="@+id/grid_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@string/pc_icon_description" />

        <ImageView
            android:id="@+id/grid_overlay"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/pc_status_description" />

        <ImageView
            android:id="@+id/grid_spinner"
            android:layout_width="48dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:src="@drawable/white_dots_animation"
            android:scaleType="fitCenter"
            android:contentDescription="@string/loading_description" />

        <LinearLayout
            android:id="@+id/grid_network_quality"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="8dp"
            android:background="@drawable/thor_pill_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:visibility="gone">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/grid_network_quality_icon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:contentDescription="@null"
                android:src="@drawable/phc_perf_wifi"
                app:tint="?attr/appAccent" />

            <TextView
                android:id="@+id/grid_network_quality_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/thor_text_secondary"
                android:textSize="11sp"
                tools:text="9 ms · 62 Mbps" />
        </LinearLayout>

        <TextView
            android:id="@+id/grid_text"
            style="@style/PcHostNameText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/thor_tile_label_bg"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textColor="@color/pc_item_text_primary"
            tools:text="Gaming PC" />
    </FrameLayout>
</FrameLayout>
