<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Controller button glyph in the hint bar (filled circle with the letter). -->
    <style name="ThorHintGlyph">
        <item name="android:layout_width">22dp</item>
        <item name="android:layout_height">22dp</item>
        <item name="android:layout_marginStart">20dp</item>
        <item name="android:background">@drawable/thor_hint_glyph</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/thor_background</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ThorHintLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:textColor">@color/thor_text_primary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- Round system button (Switch home bottom row). -->
    <style name="ThorRoundButton">
        <item name="android:layout_width">@dimen/thor_round_button</item>
        <item name="android:layout_height">@dimen/thor_round_button</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="android:background">@drawable/thor_round_button</item>
        <item name="android:padding">17dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:focusable">true</item>
    </style>

</resources>
