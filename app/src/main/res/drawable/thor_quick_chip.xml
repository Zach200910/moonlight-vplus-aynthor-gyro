<?xml version="1.0" encoding="utf-8"?>
<!-- Quick-settings choice chip: hairline when idle, bold accent frame when selected. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="120"
    android:exitFadeDuration="120">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/thor_surface_elevated" />
            <stroke android:width="@dimen/thor_border_width" android:color="@color/thor_border_strong" />
            <corners android:radius="@dimen/thor_radius_small" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/thor_surface_elevated" />
            <stroke android:width="3dp" android:color="@color/thor_accent" />
            <corners android:radius="@dimen/thor_radius_small" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/thor_surface" />
            <stroke android:width="@dimen/thor_border_width" android:color="@color/thor_border" />
            <corners android:radius="@dimen/thor_radius_small" />
        </shape>
    </item>
</selector>
