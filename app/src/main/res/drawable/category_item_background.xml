<?xml version="1.0" encoding="utf-8"?>
<!-- Settings category row: bold accent frame on focus (controller), light fill when selected/pressed. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="120"
    android:exitFadeDuration="120">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/thor_surface_elevated" />
            <stroke android:width="3dp" android:color="@color/thor_accent" />
            <corners android:radius="@dimen/thor_radius_small" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/thor_surface_elevated" />
            <corners android:radius="@dimen/thor_radius_small" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/thor_surface_elevated" />
            <corners android:radius="@dimen/thor_radius_small" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <corners android:radius="@dimen/thor_radius_small" />
        </shape>
    </item>
</selector>
