<?xml version="1.0" encoding="utf-8"?>
<!-- Flat round button (Switch style): solid surface, accent ring on focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="@integer/thor_motion_short"
    android:exitFadeDuration="@integer/thor_motion_short">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/thor_border" />
            <stroke android:width="3dp" android:color="@color/thor_accent" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="@color/thor_surface_elevated" />
            <stroke android:width="3dp" android:color="@color/thor_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/thor_surface_elevated" />
            <stroke android:width="1dp" android:color="@color/thor_border" />
        </shape>
    </item>
</selector>
